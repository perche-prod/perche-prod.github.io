---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import uh from "../assets/emotions/Funa_nerd.png";
---

<Layout title="La Perche - Page non trouvée">
    <div class="my-auto py-16 flex flex-col items-center justify-center text-center">
        <div class="max-w-lg mx-auto flex flex-col items-center">
            <div class="w-32 h-32 rounded-3xl bg-secondary p-4 mb-6 flex items-center justify-center">
                <Image
                    src={uh}
                    alt="Erreur 404"
                    height={128}
                    class="w-full h-full object-contain"
                />
            </div>

            <span class="text-xs font-bold uppercase tracking-widest text-secondary-content bg-secondary px-3 py-1 rounded-full mb-3">
                Erreur 404
            </span>

            <h1 class="text-3xl sm:text-4xl font-extrabold text-accent mb-3">
                Scène coupée au montage !
            </h1>

            <p class="text-base-content/75 text-base mb-8 max-w-sm">
                La page que vous cherchez n'existe pas ou a été déplacée vers un
                autre plateau de tournage.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 w-full justify-center">
                <a
                    href="/"
                    class="btn bg-accent text-accent-content hover:bg-accent/90 border-0 flex items-center justify-center gap-2 font-bold px-5"
                >
                    <Icon
                        name="iconmind:home-outline-thin"
                        class="w-5 h-5 text-secondary"
                    />
                    <span>Retour à l'accueil</span>
                </a>
            </div>
        </div>
    </div>
</Layout>
