---
import { Icon } from "astro-icon/components";
---

<section class="scroll-mt-24">
    <div class="bg-secondary text-secondary-content rounded-3xl p-6 md:p-10 border border-secondary-content/15 text-center">
        <div class="max-w-2xl mx-auto space-y-4 mb-8">
            <div class="badge badge-primary">
                <Icon
                    name="iconmind:social-event-outline-thin"
                    class="w-4 h-4 text-accent"
                />
                <span>Communauté & Réseaux</span>
            </div>

            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-secondary-content">
                Suivez les coulisses de nos prochains tournages !
            </h2>

            <p class="text-secondary-content/85 text-base leading-relaxed">
                Photos de plateau, annonces de casting, teasers exclusifs :
                rejoignez notre communauté sur les réseaux et échangez
                directement avec nous.
            </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
            <!-- Instagram Card -->
            <a
                href="https://www.instagram.com/laperche.prod/"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cinematic p-4 sm:p-5 w-36 sm:w-44 flex flex-col items-center justify-center gap-2.5 bg-base-100 text-accent hover:border-accent transition-all group"
                aria-label="Instagram @laperche.prod"
            >
                <div class="w-12 h-12 rounded-2xl bg-secondary text-secondary-content flex items-center justify-center group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                </div>
                <span class="font-bold text-sm text-accent">Instagram</span>
                <span class="text-[11px] text-base-content/60 font-medium">
                    @laperche.prod
                </span>
            </a>

            <!-- YouTube Card -->
            <a
                href="https://www.youtube.com/@laperche-prod"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cinematic p-4 sm:p-5 w-36 sm:w-44 flex flex-col items-center justify-center gap-2.5 bg-base-100 text-accent hover:border-accent transition-all group"
                aria-label="YouTube @laperche-prod"
            >
                <div class="w-12 h-12 rounded-2xl bg-accent-content text-accent flex items-center justify-center group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                </div>
                <span class="font-bold text-sm text-accent">YouTube</span>
                <span class="text-[11px] text-base-content/60 font-medium">
                    @laperche-prod
                </span>
            </a>

            <!-- Email Card -->
            <a
                href="mailto:bonjour@perche-prod.org"
                class="card-cinematic p-4 sm:p-5 w-36 sm:w-44 flex flex-col items-center justify-center gap-2.5 bg-base-100 text-accent hover:border-accent transition-all group"
                aria-label="Contactez-nous par email"
            >
                <div class="w-12 h-12 rounded-2xl bg-secondary text-secondary-content flex items-center justify-center group-hover:scale-110 transition-transform">
                    <Icon name="iconmind:mail-outline-thin" class="w-6 h-6" />
                </div>
                <span class="font-bold text-sm text-accent">Email</span>
                <span class="text-[11px] text-base-content/60 font-medium">
                    Contact direct
                </span>
            </a>
        </div>
    </div>
</section>
