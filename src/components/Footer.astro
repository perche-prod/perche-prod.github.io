---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/laperche.png";
import madeInImg from "../assets/madein.png";

const currentYear = new Date().getFullYear();
---

<footer class="mt-16 pt-12 pb-8 border-t border-secondary-content/15 text-secondary-content">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
        <div class="md:col-span-2 space-y-4">
            <div class="flex items-center gap-3">
                <Image
                    class="h-12 w-auto object-contain"
                    src={logo}
                    alt="Logo La Perche"
                    height={96}
                />
                <div>
                    <span class="font-black text-xl tracking-tight text-accent block leading-none">
                        LA PERCHE
                    </span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-secondary-content/70">
                        Association de cinéma (Loi 1901)
                    </span>
                </div>
            </div>
            <p class="text-sm max-w-md text-secondary-content/80 leading-relaxed">
                Collectif d'étudiants et passionnés du 7ème art. Création,
                écriture, tournage et post-production de courts-métrages et
                fictions originales.
            </p>
            <div class="flex items-center gap-3 pt-2">
                <a
                    href="https://www.instagram.com/laperche.prod/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-circle btn-sm bg-base-200 hover:bg-base-300 text-secondary-content border-secondary-content/20"
                    aria-label="Instagram de La Perche"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                </a>
                <a
                    href="https://www.youtube.com/@laperche-films"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-circle btn-sm bg-base-200 hover:bg-base-300 text-secondary-content border-secondary-content/20"
                    aria-label="Chaîne YouTube de La Perche"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                </a>
                <a
                    href="mailto:hello@funa.dev"
                    class="btn btn-circle btn-sm bg-base-200 hover:bg-base-300 text-secondary-content border-secondary-content/20"
                    aria-label="Contact par email"
                >
                    <Icon name="iconmind:mail-outline-thin" class="w-4 h-4" />
                </a>
            </div>
        </div>

        <div>
            <h4 class="font-bold text-sm tracking-wider uppercase mb-3 text-secondary-content">
                Navigation
            </h4>
            <ul class="space-y-2 text-sm">
                <li>
                    <a
                        href="/#about"
                        class="hover:underline opacity-80 hover:opacity-100"
                    >
                        À propos
                    </a>
                </li>
                <li>
                    <a
                        href="/#creations"
                        class="hover:underline opacity-80 hover:opacity-100"
                    >
                        Nos réalisations
                    </a>
                </li>
                <li>
                    <a
                        href="/#team"
                        class="hover:underline opacity-80 hover:opacity-100"
                    >
                        L'Équipe
                    </a>
                </li>
                <li>
                    <a
                        href="/join"
                        class="hover:underline opacity-80 hover:opacity-100"
                    >
                        Nous rejoindre (Recrutement)
                    </a>
                </li>
            </ul>
        </div>

        <div class="space-y-3">
            <h4 class="font-bold text-sm tracking-wider uppercase mb-3 text-secondary-content">
                Production
            </h4>
            <p class="text-xs text-secondary-content/80 leading-relaxed">
                Association déclarée sous le régime de la loi du 1er juillet
                1901. Tous droits réservés.
            </p>
            <div class="pt-2">
                <Image
                    class="h-8 w-auto opacity-75"
                    src={madeInImg}
                    alt="Made in France"
                    height={40}
                />
            </div>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 pt-6 border-t border-secondary-content/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs opacity-75">
        <p>
            © {currentYear} La Perche — Association de cinéma & création
            audiovisuelle
        </p>
        <div class="flex items-center gap-4">
            <a href="/join" class="hover:underline">
                Rejoindre l'équipe
            </a>
            <span>•</span>
            <a href="mailto:hello@funa.dev" class="hover:underline">
                Contact
            </a>
        </div>
    </div>
</footer>
