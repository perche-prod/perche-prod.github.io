---
import { Icon } from "astro-icon/components";
import YoutubeCard from "./YoutubeCard.astro";
---

<section id="creations" class="scroll-mt-24">
    <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
        <div class="badge badge-secondary">
            <Icon
                name="iconmind:video-outline-thin"
                class="w-4 h-4 text-accent"
            />
            <span>Nos Réalisations</span>
        </div>

        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-accent">
            La cuisine sauce LaPerche
        </h2>

        <p class="text-base-content/85 text-base md:text-lg leading-relaxed">
            Découvrez nos derniers courts-métrages, fictions étudiantes et
            aperçus des coulisses. Tout est pensé, écrit et réalisé avec passion
            par les membres du collectif.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 w-full">
        <YoutubeCard
            id="dQw4w9WgXcQ"
            title="Court-métrage : Première Prise"
            description="Nous ne possédons actuellement pas le droit d'utiliser ce contenu. Revenez plus tard !"
            tag="Court-métrage"
            duration="00:00"
        />
        <YoutubeCard
            id="dQw4w9WgXcQ"
            title="Best of : LaProd → LaPerche"
            description="Nous ne possédons actuellement pas le droit d'utiliser ce contenu. Revenez plus tard !"
            tag="Making-of"
            duration="00:00"
        />
    </div>

    <!-- Channel CTA -->
    <div class="mt-8 text-center">
        <a
            href="https://www.youtube.com/@laperche-films"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-base-200 border border-base-300 text-accent font-bold text-sm hover:bg-base-300 transition"
        >
            <Icon
                name="iconmind:external-link-outline-thin"
                class="w-4 h-4 text-secondary-content"
            />
            <span>Voir toutes nos créations sur YouTube</span>
        </a>
    </div>
</section>
